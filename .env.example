# Пример переменных окружения. Скопируйте в .env.local (он не попадает в репозиторий)
# или задайте в Vercel → Project → Settings → Environment Variables.

# Публичные (видны в браузере, не секрет)
NEXT_PUBLIC_SUPABASE_URL=https://kqzrnjjeyppkmqtwnspo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=haifabcbot
# Короткое имя Mini App из @BotFather, если создано через /newapp (иначе оставить пустым)
NEXT_PUBLIC_TELEGRAM_MINIAPP_SHORT_NAME=
# Адрес сайта; на Vercel можно не задавать — берётся автоматически
NEXT_PUBLIC_SITE_URL=

# Секреты (только на сервере). Никогда не присылать в чат и не коммитить.
SUPABASE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
# Необязательно: если задать, ежедневная задача /api/cron/daily принимает только вызовы Vercel Cron.
# Без него задача тоже безопасна — повторно ничего не отправляет.
CRON_SECRET=

# true — открыть сайт для поисковиков (только после запуска на постоянном домене)
SITE_INDEXABLE=false
